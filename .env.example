# Nightjar runs fully local by default. Everything here is optional.

# Local model server
OLLAMA_HOST=http://localhost:11434
NIGHTJAR_MODEL=gemma3:1b
# NIGHTJAR_MODEL=gemma3:4b        # if you have a GPU

# Optional semantic recall for the series bible (ollama pull nomic-embed-text)
NIGHTJAR_EMBED_MODEL=

# Optional narration. Requires a consented voice — see CONSENT.md.
ELEVENLABS_API_KEY=

# How many times a rejected draft is regenerated before giving up
NIGHTJAR_GUARD_RETRIES=3
